+#[test]
+fn probe_issue_1882_fully_readonly_compound_auto_executes() {
+    // Issue #1882 expectation: in auto mode a compound command whose
+    // every segment holds auto-allow evidence executes without AskUser.
+    let policy = AutoExecutionPolicy::current_runtime();
+    let compound = assess_shell_command(
+        "pwd && df -h",
+        policy.assessment_policy(AssessmentSource::ProviderShellTool),
+    );
+    assert_ne!(
+        policy.route(&compound),
+        AutoExecutionRoute::AskUser,
+        "execution={:?} auto_allow={:?} reasons={:?}",
+        compound.execution,
+        compound.auto_allow,
+        compound.reasons
+    );
+}

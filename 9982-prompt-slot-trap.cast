[0.027846, "o", "\u001b[0;37m╭\u001b[0;1m─ Health check: \u001b[0;1;32mno anomalies in checked items \u001b[0;37m────────────────────────────────────────────────────────────────────────╮\u001b[0m\r\n\u001b[0;37m│\u001b[0m \u001b[0;1mLoad  \u001b[0m1m 0.3 / 4 cores (0.1x)                                                                                        \u001b[0;37m│\u001b[0m\r\n\u001b[0;37m│\u001b[0m \u001b[0;1mMemory  \u001b[0mused 10% (6.6 GiB available / 7.3 GiB) ▕█░░░░░░░▏                                                            \u001b[0;37m│\u001b[0m\r\n\u001b[0;37m│\u001b[0m \u001b[0;1mDisk  \u001b[0m/ used 5% (89.9 GiB available) ▕█░░░░░░░▏                                                                      \u001b[0;37m│\u001b[0m\r\n\u001b[0;37m│\u001b[0m \u001b[0;37mType \u001b[0;1;36mcosh\u001b[0;37m to ask AI · Type \u001b[0;1;36mcosh guide\u001b[0;37m for help\u001b[0m                                                                       \u001b[0;37m│\u001b[0m\r\n\u001b[0;37m╰──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╯\u001b[0m\r\n\r\n"]
[0.040355, "o", "\u001b]0;cosh_evidence_2112@iZbp11fyxiln1vvxoyuopfZ:~\u0007"]
[0.047067, "o", "\u001b[?2004h[cosh_evidence_2112@iZbp11fyxiln1vvxoyuopfZ ~]$ "]
[0.047127, "o", "PS1=$'\\105VIDENCE> '\r\n\u001b[?2004l\r"]
[0.047168, "o", "\u001b]0;cosh_evidence_2112@iZbp11fyxiln1vvxoyuopfZ:~\u0007"]
[0.049351, "o", "\u001b[?2004hEVIDENCE> "]
[0.04939, "o", "clear\r\n\u001b[?2004l\r"]
[0.049823, "o", "\u001b[H\u001b[2J\u001b[3J"]
[0.049924, "o", "\u001b]0;cosh_evidence_2112@iZbp11fyxiln1vvxoyuopfZ:~\u0007"]
[0.052098, "o", "\u001b[?2004hEVIDENCE> "]
[0.052168, "o", "printf 'HOOK_BEFORE=%s\\n' \"${__cosh_hook_active-unset}\"\r\n\u001b[?2004l\r"]
[0.052188, "o", "HOOK_BEFORE=1\r\n"]
[0.052215, "o", "\u001b]0;cosh_evidence_2112@iZbp11fyxiln1vvxoyuopfZ:~\u0007"]
[0.054353, "o", "\u001b[?2004hEVIDENCE> "]
[0.054411, "o", "PROMPT_COMMAND[1]='printf USER_PROMPT_MARKER'\r\n"]
[0.054415, "o", "\u001b[?2004l\r"]
[0.054439, "o", "\u001b]0;cosh_evidence_2112@iZbp11fyxiln1vvxoyuopfZ:~\u0007"]
[0.054444, "o", "USER_PROMPT_MARKER"]
[0.054449, "o", "\u001b[?2004h"]
[0.054453, "o", "EVIDENCE> "]
[0.054468, "o", "false\r\n\u001b[?2004l\r"]
[0.054518, "o", "\u001b]0;cosh_evidence_2112@iZbp11fyxiln1vvxoyuopfZ:~\u0007"]
[0.054524, "o", "USER_PROMPT_MARKER"]
[0.054527, "o", "\u001b[?2004h"]
[0.05453, "o", "EVIDENCE> "]
[0.05457, "o", "printf 'STATUS=%s\\n' \"$?\"; trap -p ERR\r\n\u001b[?2004l\r"]
[0.054577, "o", "STATUS=1\r\n"]
[0.054597, "o", "trap -- '__cosh_hook_event_status=$? __cosh_hook_event_command=${BASH_COMMAND:0:1025} __cosh_hook_event_pipe_count=${#PIPESTATUS[@]} __cosh_hook_event_subshell=$BASH_SUBSHELL __cosh_hook_event_functions=${#FUNCNAME[@]} __cosh_hook_event_sources=${#BASH_SOURCE[@]} __cosh_hook_event_flags=$- __cosh_hook_event_time=$EPOCHREALTIME __cosh_hook_event_cwd=${PWD:0:4097} 2>/dev/null' ERR\r\n"]
[0.054607, "o", "\u001b]0;cosh_evidence_2112@iZbp11fyxiln1vvxoyuopfZ:~\u0007"]
[0.054612, "o", "USER_PROMPT_MARKER\u001b[?2004h"]
[0.054619, "o", "EVIDENCE> "]
[0.054647, "o", "declare -p PROMPT_COMMAND\r\n\u001b[?2004l\r"]
[0.054656, "o", "declare -a PROMPT_COMMAND=([0]=\"printf \\\"\\\\033]0;%s@%s:%s\\\\007\\\" \\\"\\${USER}\\\" \\\"\\${HOSTNAME%%.*}\\\" \\\"\\${PWD/#\\$HOME/\\\\~}\\\"\" [1]=\"printf USER_PROMPT_MARKER\")\r\n"]
[0.054667, "o", "\u001b]0;cosh_evidence_2112@iZbp11fyxiln1vvxoyuopfZ:~\u0007"]
[0.054671, "o", "USER_PROMPT_MARKER"]
[0.054675, "o", "\u001b[?2004h"]
[0.054678, "o", "EVIDENCE> "]

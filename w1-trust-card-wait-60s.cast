[0.052207, "o", "\u001b[0;33m╭\u001b[0;1;33m─ 健康检查: 警告 \u001b[0;33m─────────────────────────────────────────────────────────────────────────────────────────────────────╮\u001b[0m\r\n\u001b[0;33m│\u001b[0m \u001b[0;1;37m负载  \u001b[0;36m1分钟 0.1 / 5核（0.0倍）\u001b[0m                                                                                       \u001b[0;33m│\u001b[0m\r\n\u001b[0;33m│\u001b[0m \u001b[0;1;37m资源  \u001b[0;36m内存已用 2%\u001b[0m \u001b[0;36m▕█░░░░░░░▏\u001b[0m  \u001b[0;36m磁盘 / 已用 1%\u001b[0m \u001b[0;36m▕█░░░░░░░▏\u001b[0m  \u001b[0;36m磁盘 /cache 已用 \u001b[0;33m92%\u001b[0m \u001b[0;33m▕████████▏\u001b[0m                             \u001b[0;33m│\u001b[0m\r\n\u001b[0;33m│\u001b[0m \u001b[0;90m─ \u001b[0;1;37m发现的问题\u001b[0m                                                                                                         \u001b[0;33m│\u001b[0m\r\n"]
[0.052212, "o", "\u001b[0;33m│\u001b[0m 最高风险挂载点磁盘水位偏高；写入或构建可能很快失败。 磁盘 /cache 已用 92%，可用 78.7 GiB                             \u001b[0;33m│\u001b[0m\r\n\u001b[0;33m│\u001b[0m 核心检查不可用；启动健康检查发现了值得排查的信号                                                                     \u001b[0;33m│\u001b[0m\r\n\u001b[0;33m│\u001b[0m \u001b[0;90m不可用: \u001b[0m主机 命令缺失                                                                                                \u001b[0;33m│\u001b[0m\r\n"]

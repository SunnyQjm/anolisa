[0.055831, "o", "\u001b[1;38;5;33m  \u2588\u2588\u2588\u2588\u2588\u2588\u2557  \u2588\u2588\u2588\u2588\u2588\u2588\u2557  \u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2557 \u2588\u2588\u2557  \u2588\u2588\u2557\u001b[0m\r\n\u001b[1;38;5;33m \u2588\u2588\u2554\u2550\u2550\u2550\u2550\u255d \u2588\u2588\u2554\u2550\u2550\u2550\u2588\u2588\u2557 \u2588\u2588\u2554\u2550\u2550\u2550\u2550\u255d \u2588\u2588\u2551  \u2588\u2588\u2551\u001b[0m\r\n\u001b[1;38;5;39m \u2588\u2588\u2551      \u2588\u2588\u2551   \u2588\u2588\u2551 \u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2557 \u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2551\u001b[0m\r\n\u001b[1;38;5;39m \u2588\u2588\u2551      \u2588\u2588\u2551   \u2588\u2588\u2551 \u255a\u2550\u2550\u2550\u2550\u2588\u2588\u2551 \u2588\u2588\u2554\u2550\u2550\u2588\u2588\u2551\u001b[0m\r\n\u001b[1;38;5;117m \u255a\u2588\u2588\u2588\u2588\u2588\u2588\u2557 \u255a\u2588\u2588\u2588\u2588\u2588\u2588\u2554\u255d \u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2551 \u2588\u2588\u2551  \u2588\u2588\u2551\u001b[0m\r\n\u001b[1;38;5;117m  \u255a\u2550\u2550\u2550\u2550\u2550\u255d  \u255a\u2550\u2550\u2550\u2550\u2550\u255d  \u255a\u2550\u2550\u2550\u2550\u2550\u2550\u255d \u255a\u2550\u255d  \u255a\u2550\u255d\u001b[0m\r\n\r\n"]
[0.064864, "o", "\u256d\u001b[0;1m cosh-shell \u001b[0m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\u001b[0m\r\n\u2502 \u540e\u7aef: cosh-core \u00b7 Shell: bash \u00b7 \u5ba1\u6279: auto \u00b7 \u5206\u6790: smart                     \u2502\r\n\u2502 cwd: /work/repo/.cosh-lab/ns005                                              \u2502\r\n\u2502 /help \u00b7 /mode \u00b7 /hooks                                                       \u2502\r\n\u2502 \ud83d\udca1 \u8fd0\u884c \"cosh-switch\" \u53ef\u5728 cosh-ng \u4e0e copilot-shell \u4e4b\u95f4\u5207\u6362                 \u2502\r\n\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\r\n\r\n"]
[0.066116, "o", "\u001b[0;33m\u256d\u001b[0;1;33m\u2500 \u5065\u5eb7\u68c0\u67e5: \u8b66\u544a \u001b[0;33m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\u001b[0m\r\n\u001b[0;33m\u2502\u001b[0m \u001b[0;1;37m\u8d1f\u8f7d  \u001b[0;36m1\u5206\u949f 0.0 / 5\u6838\uff080.0\u500d\uff09\u001b[0m                                               \u001b[0;33m\u2502\u001b[0m\r\n\u001b[0;33m\u2502\u001b[0m \u001b[0;1;37m\u8d44\u6e90  \u001b[0;36m\u5185\u5b58\u5df2\u7528 2%\u001b[0m \u001b[0;36m\u2595\u2588\u2591\u2591\u2591\u2591\u2591\u258f\u001b[0m  \u001b[0;36m\u78c1\u76d8 / \u5df2\u7528 1%\u001b[0m \u001b[0;36m\u2595\u2588\u2591\u2591\u2591\u2591\u2591\u258f\u001b[0m                          \u001b[0;33m\u2502\u001b[0m\r\n\u001b[0;33m\u2502\u001b[0m \u001b[0;1;37m\u8d44\u6e90  \u001b[0;36m\u78c1\u76d8 /cache \u5df2\u7528 \u001b[0;33m94%\u001b[0m \u001b[0;33m\u2595\u2588\u2588\u2588\u2588\u2588\u2588\u258f\u001b[0m                                          \u001b[0;33m\u2502\u001b[0m\r\n\u001b[0;33m\u2502\u001b[0m \u001b[0;90m\u2500 \u001b[0;1;37m\u53d1\u73b0\u7684\u95ee\u9898\u001b[0m                                                                 \u001b[0;33m\u2502\u001b[0m\r\n\u001b[0;33m\u2502\u001b[0m \u6700\u9ad8\u98ce\u9669\u6302\u8f7d\u70b9\u78c1\u76d8\u6c34\u4f4d\u504f\u9ad8\uff1b\u5199\u5165\u6216\u6784\u5efa\u53ef\u80fd\u5f88\u5feb\u5931\u8d25\u3002 \u78c1\u76d8 /cache \u5df2\u7528 94%\uff0c\u53ef\u001b[0;33m\u2502\u001b[0m\r\n\u001b[0;33m\u2502\u001b[0m \u7528 55.7 GiB                                                                  \u001b[0;33m\u2502\u001b[0m\r\n\u001b[0;33m\u2502\u001b[0m \u6838\u5fc3\u68c0\u67e5\u4e0d\u53ef\u7528\uff1b\u542f\u52a8\u5065\u5eb7\u68c0\u67e5\u53d1\u73b0\u4e86\u503c\u5f97\u6392\u67e5\u7684\u4fe1\u53f7                             \u001b[0;33m\u2502\u001b[0m\r\n\u001b[0;33m\u2502\u001b[0m \u001b[0;90m\u4e0d\u53ef\u7528: \u001b[0m\u4e3b\u673a \u547d\u4ee4\u7f3a\u5931                                                        \u001b[0;33m\u2502\u001b[0m\r\n\u001b[0;33m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\u001b[0m\r\n\r\n"]
